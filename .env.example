# Copy to .env and fill in. Never commit .env.

# PostgreSQL (system of record)
DATABASE_URL=postgresql://codecollab:change_me@localhost:5432/codecollab

# MongoDB (activity stream, comment threads, notifications)
MONGO_URL=mongodb://127.0.0.1:27017/codecollab

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change_me

# GitHub ingestion (personal access token, read-only public repo scope)
GITHUB_TOKEN=

# Seed skeleton (npm run seed): password for the seeded accounts. Choose your own, 8-128 characters.
SEED_PASSWORD=
