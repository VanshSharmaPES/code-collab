{
  "name": "code-collab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test src/lib/*.test.ts scripts/*.test.ts",
    "seed": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
